{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        /* Output & Build */
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        "noEmit": true,

        /* Target & Environment */
        "target": "ES2025",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2025", "DOM"],
        "allowImportingTsExtensions": true,
        "moduleDetection": "force",

        /* Paths & Types */
        "paths": {
            "@/main/*": ["./src/main/*"],
            "@/renderer/*": ["./src/renderer/*"],
            "@/schemas/*": ["./src/schemas/*"],
            "@/preload/*": ["./src/preload/*"],
            "@test-utils": ["./tests/renderer/test-utils"]
        },
        "types": ["node", "vitest/globals"]
    },
    "include": ["vitest.setup.ts", "tests/**/*.ts", "src/**/*.d.ts"]
}
