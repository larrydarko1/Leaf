{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        /* Output & Build */
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
        "noEmit": true,

        /* Target & Environment — the gates run on the Node that `engines` pins,
           not the one bundled into Electron. */
        "target": "ES2025",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2025"],

        /* Paths & Types */
        "types": ["node"],

        /* Module System — Node strips the types and runs the file as-is, so
           imports name the real `.ts` file; nothing rewrites them. */
        "allowImportingTsExtensions": true,
        "moduleDetection": "force"
    },
    "include": ["scripts/**/*.ts"]
}
